APP_ENV=local
HOST=127.0.0.1
PORT=8000
UPLOAD_DIR=.data/uploads
OUTPUT_DIR=.data/outputs
SOUND_FONT_PATH=assets/piano.sf2

# Local/dev CORS is restricted to localhost by code. Production must set explicit origins.
CORS_ALLOW_ORIGINS=

# Cloud parent origins allowed to embed Studio. Local defaults only; add staging/production in server envs.
H2S_CLOUD_PARENT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3010,http://127.0.0.1:3010,http://localhost:3012,http://127.0.0.1:3012

# Vocal separation (research): POST /generate?vocal_separation=true (not exposed in Studio UI).
# Stems + vocal-only transcription use H2S_STEM_SEPARATION_BACKEND=stub | demucs
# H2S_STEM_SEPARATION_BACKEND=stub
# H2S_DEMUCS_MODEL=htdemucs_ft
# Legacy (pipeline ignores; task checkbox gates): H2S_EXPERIMENTAL_TWO_STEM_SEPARATION=false

# Gateway-first LLM (placeholders only; do not put provider keys in browser)
# For gateway/proxy or future backend; frontend does not auto-load repo .env.
LLM_BASE_URL=
LLM_MODEL=
LLM_AUTH_TOKEN=
